@model CinemaMVC.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="mx-auto max-w-xl px-4 py-16 text-center">
    <h1 class="page-title">Une erreur est survenue</h1>
    <p class="page-lead">L'incident a été enregistré. Vous pouvez revenir à l'accueil et réessayer.</p>

    @if (Model?.ShowRequestId == true)
    {
        <p class="mt-4 text-xs text-slate-400">Référence : <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn-primary mt-8">Retour à l'accueil</a>
</div>
