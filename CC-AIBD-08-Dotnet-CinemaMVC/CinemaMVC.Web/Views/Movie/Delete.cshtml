@model CinemaMVC.Web.Models.Entities.Movie
@{
    ViewData["Title"] = "Supprimer un film";
}

<div class="page-narrow">
    <h1 class="page-title">Supprimer ce film ?</h1>
    <p class="page-lead">Cette action est définitive et supprimera aussi toutes ses séances.</p>

    <div class="card card-body mt-6">
        <dl class="divide-y divide-slate-200">
            <div class="dl-row"><dt class="dl-label">Titre</dt><dd class="dl-value">@Model.Title</dd></div>
            <div class="dl-row"><dt class="dl-label">Genre</dt><dd class="dl-value">@Model.Genre</dd></div>
            <div class="dl-row"><dt class="dl-label">Durée</dt><dd class="dl-value">@Model.DurationMinutes min</dd></div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions mt-6">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-danger">Supprimer définitivement</button>
            <a asp-action="Index" class="btn-secondary">Annuler</a>
        </form>
    </div>
</div>
