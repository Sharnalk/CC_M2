@model CinemaMVC.Web.Controllers.HomeViewModel
@{
    ViewData["Title"] = "Accueil";
    var searchCinema = ViewData["SearchCinema"] as string;
    var searchMovie = ViewData["SearchMovie"] as string;
}

<div class="bg-slate-900 py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center">
        <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">Trouvez votre séance</h1>
        <p class="mt-4 text-lg text-slate-300">
            Explorez nos cinémas et consultez la programmation du jour.
        </p>
    </div>
</div>

<div class="page">
    <div class="grid gap-10 lg:grid-cols-3">

        <aside class="card card-body h-fit">
            <h2 class="text-base font-semibold text-slate-900">Rechercher un film</h2>

            <form method="get" class="mt-4 space-y-3">
                <input type="hidden" name="searchCinema" value="@searchCinema" />
                <label for="searchMovie" class="sr-only">Titre du film</label>
                <input id="searchMovie" type="text" name="searchMovie" value="@searchMovie" class="input" placeholder="Ex : Inception, Avatar..." />
                <button type="submit" class="btn-primary w-full justify-center">Rechercher les séances</button>
                @if (!string.IsNullOrEmpty(searchMovie))
                {
                    <a asp-action="Index" asp-route-searchCinema="@searchCinema" class="block text-center text-xs link-action">Effacer la recherche</a>
                }
            </form>

            @if (!string.IsNullOrEmpty(searchMovie))
            {
                <div class="mt-6 border-t border-slate-200 pt-5">
                    <h3 class="text-sm font-semibold text-slate-900">Résultats pour « @searchMovie »</h3>

                    @if (!Model.MovieSessions.Any())
                    {
                        <p class="mt-3 text-sm text-slate-500">Aucune séance trouvée pour ce film.</p>
                    }

                    <div class="mt-3 space-y-3">
                        @foreach (var session in Model.MovieSessions)
                        {
                            <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">
                                <p class="text-sm font-medium text-slate-900">@session.Movie?.Title</p>
                                <p class="mt-1 text-xs text-slate-500">
                                    @session.Room?.Cinema?.Name · @session.Room?.Name
                                </p>
                                <div class="mt-2 flex items-center justify-between border-t border-slate-200 pt-2 text-xs">
                                    <span class="font-semibold text-brand-600">@session.ShowTime.ToString("dd/MM HH:mm")</span>
                                    <span class="badge">@session.Price.ToString("F2") €</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </aside>

        <section class="lg:col-span-2">
            <div class="flex flex-col gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <h2 class="page-title">Nos cinémas</h2>
                    <p class="page-lead">Sélectionnez un cinéma pour voir sa programmation.</p>
                </div>
                <form method="get" class="flex gap-2">
                    <input type="hidden" name="searchMovie" value="@searchMovie" />
                    <label for="searchCinema" class="sr-only">Cinéma ou ville</label>
                    <input id="searchCinema" type="text" name="searchCinema" value="@searchCinema" class="input" placeholder="Cinéma ou ville" />
                    <button type="submit" class="btn-dark">Filtrer</button>
                    @if (!string.IsNullOrEmpty(searchCinema))
                    {
                        <a asp-action="Index" asp-route-searchMovie="@searchMovie" class="btn-secondary">Effacer</a>
                    }
                </form>
            </div>

            @if (!Model.Cinemas.Any())
            {
                <div class="card mt-8 p-12 text-center">
                    <p class="text-sm font-medium text-slate-900">Aucun cinéma disponible</p>
                    <p class="page-lead">Essayez de modifier vos critères de recherche.</p>
                </div>
            }

            <div class="mt-8 grid gap-5 md:grid-cols-2">
                @foreach (var cinema in Model.Cinemas)
                {
                    <div class="card card-body flex flex-col justify-between">
                        <div>
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="text-base font-semibold text-slate-900">@cinema.Name</h3>
                                <span class="badge shrink-0">@cinema.City</span>
                            </div>
                            <p class="page-lead">@cinema.Address</p>
                        </div>
                        <a asp-action="CinemaDetails" asp-route-id="@cinema.Id" class="btn-secondary mt-5 justify-center">
                            Voir la programmation
                        </a>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
