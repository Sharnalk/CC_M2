@model CinemaMVC.Web.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="mx-auto max-w-md px-4 py-16">
    <h1 class="page-title text-center">Mot de passe oublié</h1>
    <p class="page-lead text-center">Indiquez votre adresse, nous générerons un lien de réinitialisation.</p>

    <div class="card card-body mt-8">
        <form asp-action="ForgotPassword" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>

            <div>
                <label asp-for="Email" class="label">Adresse e-mail</label>
                <input asp-for="Email" class="input" placeholder="vous@exemple.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary w-full justify-center">Envoyer le lien</button>
            <a asp-action="Login" class="block text-center text-sm link-action">Retour à la connexion</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
