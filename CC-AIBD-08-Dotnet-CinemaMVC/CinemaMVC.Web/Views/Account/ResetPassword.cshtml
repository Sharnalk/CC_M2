@model CinemaMVC.Web.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Réinitialiser le mot de passe";
}

<div class="mx-auto max-w-md px-4 py-16">
    <h1 class="page-title text-center">Nouveau mot de passe</h1>
    <p class="page-lead text-center">Choisissez un nouveau mot de passe pour votre compte.</p>

    <div class="card card-body mt-8">
        <form asp-action="ResetPassword" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <input type="hidden" asp-for="Token" />

            <div>
                <label asp-for="Email" class="label">Adresse e-mail</label>
                <input asp-for="Email" class="input" placeholder="vous@exemple.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div>
                <label asp-for="Password" class="label">Nouveau mot de passe</label>
                <input asp-for="Password" class="input" placeholder="••••••••" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="label">Confirmer le nouveau mot de passe</label>
                <input asp-for="ConfirmPassword" class="input" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-primary w-full justify-center">Réinitialiser</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
