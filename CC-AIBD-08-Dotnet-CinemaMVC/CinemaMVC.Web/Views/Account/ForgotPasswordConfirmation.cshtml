@{
    ViewData["Title"] = "Lien de réinitialisation";
    var resetLink = TempData["ResetLink"] as string;
}

<div class="mx-auto max-w-xl px-4 py-16">
    <h1 class="page-title text-center">Demande enregistrée</h1>
    <p class="page-lead text-center">Si cette adresse existe, un lien de réinitialisation a été généré.</p>

    <div class="card card-body mt-8">
        @if (!string.IsNullOrEmpty(resetLink))
        {
            @* Aucun serveur SMTP n'est configuré : le lien est affiché ici pour que
               le parcours reste testable de bout en bout. *@
            <p class="text-sm text-slate-600">
                Aucun serveur d'envoi d'e-mail n'étant configuré, le lien s'affiche directement :
            </p>
            <a href="@resetLink" class="mt-3 block break-all rounded-lg bg-slate-50 p-3 text-xs link-action">@resetLink</a>
        }
        else
        {
            <p class="text-sm text-slate-600">Consultez votre messagerie pour poursuivre.</p>
        }

        <a asp-action="Login" class="btn-secondary mt-6">Retour à la connexion</a>
    </div>
</div>
