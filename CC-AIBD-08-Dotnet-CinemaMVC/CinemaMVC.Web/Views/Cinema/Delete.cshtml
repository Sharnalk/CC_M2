@model CinemaMVC.Web.Models.Entities.Cinema
@{
    ViewData["Title"] = "Supprimer un cinéma";
}

<div class="page-narrow">
    <h1 class="page-title">Supprimer ce cinéma ?</h1>
    <p class="page-lead">Cette action est définitive et supprimera aussi ses salles et leurs séances.</p>

    <div class="card card-body mt-6">
        <dl class="divide-y divide-slate-200">
            <div class="dl-row"><dt class="dl-label">Nom</dt><dd class="dl-value">@Model.Name</dd></div>
            <div class="dl-row"><dt class="dl-label">Adresse</dt><dd class="dl-value">@Model.Address</dd></div>
            <div class="dl-row"><dt class="dl-label">Ville</dt><dd class="dl-value">@Model.City</dd></div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions mt-6">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-danger">Supprimer définitivement</button>
            <a asp-action="Index" class="btn-secondary">Annuler</a>
        </form>
    </div>
</div>
