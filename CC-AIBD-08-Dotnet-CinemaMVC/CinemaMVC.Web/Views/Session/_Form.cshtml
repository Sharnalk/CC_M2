@model CinemaMVC.Web.Models.Entities.Session

<div class="grid gap-5 sm:grid-cols-2">
    <div>
        <label asp-for="MovieId" class="label">Film</label>
        <select asp-for="MovieId" asp-items="ViewBag.MovieId" class="input">
            <option value="">-- Sélectionner un film --</option>
        </select>
        <span asp-validation-for="MovieId" class="field-error"></span>
    </div>
    <div>
        <label asp-for="RoomId" class="label">Salle</label>
        <select asp-for="RoomId" asp-items="ViewBag.RoomId" class="input">
            <option value="">-- Sélectionner une salle --</option>
        </select>
        <span asp-validation-for="RoomId" class="field-error"></span>
    </div>
</div>

<div class="grid gap-5 sm:grid-cols-2">
    <div>
        <label asp-for="ShowTime" class="label">Horaire</label>
        <input asp-for="ShowTime" type="datetime-local" class="input" />
        <span asp-validation-for="ShowTime" class="field-error"></span>
    </div>
    <div>
        <label asp-for="Price" class="label">Tarif (€)</label>
        <input asp-for="Price" type="number" step="0.01" class="input" placeholder="Ex : 9.50" />
        <span asp-validation-for="Price" class="field-error"></span>
    </div>
</div>
