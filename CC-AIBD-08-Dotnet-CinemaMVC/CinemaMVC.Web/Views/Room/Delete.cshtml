@model CinemaMVC.Web.Models.Entities.Room
@{
    ViewData["Title"] = "Supprimer une salle";
}

<div class="page-narrow">
    <h1 class="page-title">Supprimer cette salle ?</h1>
    <p class="page-lead">Cette action est définitive et supprimera aussi ses séances.</p>

    <div class="card card-body mt-6">
        <dl class="divide-y divide-slate-200">
            <div class="dl-row"><dt class="dl-label">Cinéma</dt><dd class="dl-value">@(Model.Cinema?.Name ?? "Inconnu")</dd></div>
            <div class="dl-row"><dt class="dl-label">Salle</dt><dd class="dl-value">@Model.Name</dd></div>
            <div class="dl-row"><dt class="dl-label">Capacité</dt><dd class="dl-value">@Model.Capacity places</dd></div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions mt-6">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-danger">Supprimer définitivement</button>
            <a asp-action="Index" class="btn-secondary">Annuler</a>
        </form>
    </div>
</div>
