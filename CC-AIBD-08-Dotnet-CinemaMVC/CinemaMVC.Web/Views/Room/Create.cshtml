@model CinemaMVC.Web.Models.Entities.Room
@{
    ViewData["Title"] = "Ajouter une salle";
}

<div class="page-narrow">
    <h1 class="page-title">Ajouter une salle</h1>
    <p class="page-lead">Rattachez la salle à un cinéma existant.</p>

    <div class="card card-body mt-6">
        <form asp-action="Create" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn-primary">Enregistrer</button>
                <a asp-action="Index" class="btn-secondary">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
