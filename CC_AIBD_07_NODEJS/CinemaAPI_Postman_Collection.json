				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.environment.set(\"jwtToken\", response.token);",
									"    console.log(\"JWT Token successfully saved to environment: \", response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
